# Node.js dependencies
# No trailing slash: agent worktrees get node_modules as a *symlink*, and a
# trailing slash matches directories only, so `node_modules/` left the symlink
# untracked and `git add -A` committed it.
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs
logs/
*.log
*.log.*

# Environment variables
.env
.env.*

# Build output
dist/
build/
out/
.docusaurus/
tsconfig*.tsbuildinfo

# System files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp

# Test coverage
coverage/

# Temporary files
*.tmp
*.temp

# Claude Code personal settings
.claude/settings.local.json

# Stitch / design import workspace (regenerated from zip)
.stitch-import/

# Design handoff bundles (reference material, applied to apps/docs — not shipped)
design_handoff_docusaurus_redesign*/
FIX-duplicate-route.md
.claude/ai-loop-status
