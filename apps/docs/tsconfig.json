{
	// Inlines @docusaurus/tsconfig instead of extending it: that preset sets
	// `baseUrl`, which TypeScript 7 removed (TS5102), and nothing can suppress
	// it. With no `baseUrl`, `paths` resolves relative to this file, so
	// `@site/*` still points at apps/docs.
	"compilerOptions": {
		"allowJs": true,
		"esModuleInterop": true,
		"jsx": "preserve",
		"target": "ES2022",
		"lib": ["ES2022", "DOM"],
		"moduleResolution": "bundler",
		"module": "esnext",
		"noEmit": true,
		"paths": {
			"@site/*": ["./*"]
		},
		"skipLibCheck": true
	},
	"include": ["src/", "docusaurus.config.ts", "sidebars.ts"],
	"exclude": [".docusaurus", "build", "node_modules"]
}
