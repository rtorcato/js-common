{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "root": false,
  "extends": ["@rtorcato/repo-tooling/biome"],
  "markdown": { "formatter": { "enabled": false } },
  "yaml": { "formatter": { "enabled": false } },
  "files": {
    "includes": [
      "!**/.docusaurus",
      "!**/build",
      "!**/node_modules",
      "!**/test-results",
      "!**/playwright-report"
    ]
  },
  "overrides": [
    {
      "includes": ["src/css/custom.css"],
      "linter": {
        "rules": {
          "complexity": { "noImportantStyles": "off" },
          "style": { "noDescendingSpecificity": "off" }
        }
      }
    }
  ]
}
